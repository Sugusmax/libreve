{
  "expo": {
    "name": "Libreve",
    "slug": "libreve",
    "version": "0.2.1",
    "scheme": "libreve",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon-master-1024.png",
    "splash": {
      "backgroundColor": "#F7F4EF",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.libreve.native",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground-1080.png",
        "backgroundImage": "./assets/adaptive-icon-background-1080.png"
      }
    },
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon-192.png"
    },
    "plugins": [
      "expo-secure-store"
    ]
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-7798680358413450~5918332542",
    "ios_app_id": "ca-app-pub-3940256099942544~1458002511"
  }
}
